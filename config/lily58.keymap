#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 2400
#define L_NUM 1
#define L_SYM 2
#define L_MOU 3
#define L_MO1 4
#define L_MO2 5

&mmv {
    acceleration-exponent = <2>;      // 1 = constant, 2 = exponential ramp-up
    time-to-max-speed-ms = <200>;     // How long to reach full speed (for analog feel)
    delay-ms = <0>;                   // No delay when pressing key
};

&mmv_input_listener {
    precision_layer {
        layers = <L_MO1>;
        input-processors = <&zip_xy_scaler 1 2>; 
    };

    precision_more {
        layers = <L_MO2>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
};

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <220>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
            quick-tap-ms = <200>;
            hold-while-undecided;
        };
        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <220>;
            bindings = <&mo>, <&kp>;
            quick-tap-ms = <200>;
            display-name = "Layer-Tap";
            hold-while-undecided;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp TAB       &kp Q  &kp W     &kp E     &kp R     &kp T               &kp Y      &kp U     &kp I          &kp O    &kp P    &kp BSPC
    &kp ESC       &kp A  &kp S     &kp D     &kp F     &kp G               &kp H      &kp J     &kp K          &kp L    &kp SEMI &kp ENTER
    &kp LSHFT     &kp Z  &kp X     &kp C     &kp V     &kp B               &kp N      &kp M     &kp COMMA      &kp DOT  &kp FSLH &mt RSHFT SINGLE_QUOTE
    &kp LCTRL     &none  &none     &kp LGUI  &kp LALT  &lt L_NUM SPACE
                                                              &none  &none &kp SPACE  &mo L_SYM &mt RCTRL LEFT &kp DOWN &kp UP   &kp RIGHT
    &none &none &none &none &none &none &none &none
            >;
        };

        layer_number {
            bindings = <
    &kp GRAVE &kp F1  &kp F2  &kp F3    &kp F4  &kp F5                  &trans     &kp N7   &kp N8  &kp N9  &trans        &trans
    &trans    &kp F6  &kp F7  &kp F8    &kp F9  &kp F10                 &kp PLUS   &kp N4   &kp N5  &kp N6  &kp MINUS     &trans
    &trans    &kp F11 &kp F12 &kp PSCRN &kp SCROLLLOCK
                                                &kp PAUSE_BREAK         &kp ASTRK  &kp N1   &kp N2  &kp N3  &kp KP_SLASH  &kp EQUAL
    &trans    &trans  &trans  &trans    &trans  &trans   &none  &none   &trans     &kp N0   &kp N0  &kp DOT &kp COMMA     &kp ESC
    &none &none &none &none &none &none &none &none
            >;
        };

        layer_symbol {
            bindings = <
    &kp TILDE &kp EXCL &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT                &kp CARET   &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
    &trans    &trans   &trans  &trans    &trans      &trans                   &kp LC(Z)   &kp LC(X) &kp LC(C)  &kp LC(V) &kp LS(MINUS) &trans
    &trans    &trans   &trans  &trans    &trans      &trans                   &kp LS(LEFT_BRACKET)
                                                                                          &kp LS(RIGHT_BRACKET)
                                                                                                    &kp LEFT_BRACKET      
                                                                                                               &kp RIGHT_BRACKET     
                                                                                                                         &kp BACKSLASH     
                                                                                                                                   &kp LS(BACKSLASH)
    &trans    &trans   &trans  &trans    &trans      &trans    &none  &none   &trans      &trans    &trans     &trans    &trans    &trans
    &none &none &none &none &none &none &none &none
            >;
        };
        
    };
};

