#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    behaviors {
        td_left_ctrl: td_left_ctrl {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LEFT_CTRL";
            #binding-cells = <0>;

            tapping-term-ms = <200>;

            bindings = <
                &kp LEFT        /* single tap */
                &kp LEFT        /* double tap */
                &kp LEFT        /* more taps */
            >;

            hold-bindings = <
                &kp RCTRL       /* hold */
                &kp LEFT        /* double-tap-hold → LEFT held */
                &kp LEFT
            >;
        };
        td_l1: td_enter_layer1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ENTER_LAYER1";
            #binding-cells = <0>;

            tapping-term-ms = <200>;
            flavor = "tap-preferred";

            bindings = <
                &mo 1     /* tap */
                &to 1     /* double tap → enter */
            >;

            hold-bindings = <
                &mo 1
                &to 1
            >;
        };
        td_l2: td_enter_layer2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ENTER_LAYER2";
            #binding-cells = <0>;

            tapping-term-ms = <200>;
            flavor = "tap-preferred";

            bindings = <
                &mo 2     /* tap */
                &to 2     /* double tap → enter */
            >;

            hold-bindings = <
                &mo 2
                &to 2
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
    &kp TAB   &kp Q  &kp W     &kp E     &kp R    &kp T                    &kp Y      &kp U    &kp I          &kp O    &kp P    &kp BSPC
    &kp ESC   &kp A  &kp S     &kp D     &kp F    &kp G                    &kp H      &kp J    &kp K          &kp L    &kp SEMI &kp ENTER
    &kp LSHFT &kp Z  &kp X     &kp C     &kp V    &kp B                    &kp N      &kp M    &kp COMMA      &kp DOT  &kp FSLH &mt RSHFT SINGLE_QUOTE
    &kp LCTRL &none  &kp LGUI  &kp LALT  &td_l1   &kp SPACE  &none  &none  &kp SPACE  &td_l2   &td_left_ctrl  &kp DOWN &kp UP   &kp RIGHT
                               &none     &none    &none      &none  &none  &none      &none    &none
            >;
        };

        layer1 {
            bindings = <
    &kp GRAVE &kp F1  &kp F2  &kp F3    &kp F4  &kp F5                  &trans     &kp N7   &kp N8  &kp N9  &trans        &trans
    &trans    &kp F6  &kp F7  &kp F8    &kp F9  &kp F10                 &kp PLUS   &kp N4   &kp N5  &kp N6  &kp MINUS     &trans
    &trans    &kp F11 &kp F12 &kp PSCRN &kp SCROLLLOCK
                                                &kp PAUSE_BREAK         &kp ASTRK  &kp N1   &kp N2  &kp N3  &kp KP_SLASH  &kp EQUAL
    &trans    &trans  &trans  &trans    &to 0   &trans    &none  &none  &trans     &kp N0   &kp N0  &kp DOT &kp COMMA     &kp ESC
                              &none     &none   &none     &none  &none  &none      &none    &none
            >;
        };

        layer2 {
            bindings = <
    &kp TILDE &kp EXCL &kp AT  &kp HASH  &kp DOLLAR  &kp PRCNT                &kp CARET   &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
    &trans    &trans   &trans  &trans    &trans      &trans                   &kp LC(Z)   &kp LC(X) &kp LC(C)  &kp LC(V) &kp LS(MINUS) &trans
    &trans    &trans   &trans  &trans    &trans      &trans                   &kp LS(LEFT_BRACKET)
                                                                                          &kp LS(RIGHT_BRACKET)
                                                                                                    &kp LEFT_BRACKET      
                                                                                                               &kp RIGHT_BRACKET     
                                                                                                                         &kp BACKSLASH     
                                                                                                                                   &kp LS(BACKSLASH)
    &trans    &trans   &trans  &trans    &trans      &trans    &none  &none   &trans      &to 0     &kp HOME   &kp PG_UP &kp PG_DN &kp END 
                               &none     &none       &none     &none  &none   &none       &none     &none
            >;
        };
    };
};